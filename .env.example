# Domain Looker environment variables
#
# Copy this file to `.env` and adjust as needed:
#     cp .env.example .env
#
# Every value here is OPTIONAL. Domain Looker requires no API keys, tokens,
# or credentials — it talks only to the public IANA RDAP bootstrap and the
# public RDAP servers it points to.

# Port the Express server (API + built frontend) listens on.
# Default: 3001
PORT=3001

# Demo mode. Set to 1 or true to return simulated, offline results instead of
# querying live RDAP servers — handy for exploring the UI with no network.
# Default: off (live RDAP)
DOMAIN_LOOKER_DEMO=0
